# Image-baked config defaults — NON-SECRET values only (this file is committed).
#
# The Dockerfile copies this to /app/.env; app.py main() loads it into os.environ
# at boot (load_env_file), setdefault-style, so a Railway service variable with
# the same name always overrides the value here — delete the Railway variable to
# fall back to this default. Secrets (API keys, tokens, MONGO_URL) stay in
# Railway variables. Only list values that DIFFER from the code defaults.
#
# Local dev reads your own .env instead (see .env.example), not this file.

# News-trigger research model. Unset, it falls through CLAUDE_MODEL to the Opus
# client default (2x Sonnet pricing) — the 2026-09 run burned Opus rates this way.
NEWS_MODEL=claude-sonnet-5-5

# Email Bison instance + default campaign.
EMAILBISON_BASE_URL=https://send.chatrevenue.ai

# Background loops — all OFF for this deployment (code default is on).
AISDR_SYNC_ENABLED=0
HUBSPOT_ACTIVITY_AUTOSYNC=0
HUBSPOT_ACTIVITY_AUTOSYNC_FULL=0
HEYREACH_ACTIVITY_AUTOSYNC=0
SLA_ENABLED=0
UNENROLL_CHECK_ENABLED=0

# HubSpot write-backs — all OFF (the client has no CRM; code default is on).
TECH_HUBSPOT_WRITEBACK=0
HIRING_HUBSPOT_WRITEBACK=0
NEWS_HUBSPOT_WRITEBACK=0
SDR_NOTES_HUBSPOT_WRITEBACK=0
