# Secrets — never commit
.env
# Clay OAuth tokens (access + refresh) live here:
data/outreach/clay_oauth.json
# Transient Clay sourcing job candidate files:
data/outreach/source-jobs/
# SLA rules + pull history (runtime state on the volume)
data/outreach/slas.json
data/outreach/pull_history.json
# CSV audience uploads (registry + the raw uploaded files; runtime state on the volume)
data/outreach/csv_audiences.json
data/outreach/csv-uploads/
# Autosync health status (runtime state; written by the server on every sync tick)
data/interested-replies/.autosync_status.json

# The pipeline DB is runtime state (the committed template DB was purged for the
# Value Global deployment — the app creates it at boot; prod lives on the volume)
data/outreach/pipeline.db
# Transient SQLite WAL/SHM sidecar files
*.db-wal
*.db-shm

# Python
__pycache__/
*.pyc

# Node / build output
node_modules/
dist/

# OS
.DS_Store
deck-renderer/export-deck-bites/
deck-renderer/.deck.lock
# Signal plays are runtime artifacts (built per lead, live on the volume)
data/signal-plays/
